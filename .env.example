# Enigma Environment Configuration

# Optional: Google AI Studio or Vertex AI Gemini API Key for Live ADK Agent runs
# If omitted or running in Replay mode, cached serialized runs from seed_data/replays/ are used.
GEMINI_API_KEY=

# Optional: GitHub Personal Access Token scoped strictly to the sandbox repository
# If omitted, simulated draft PR links are generated and recorded in the audit trail.
GITHUB_TOKEN=

# Sandbox repository target (do NOT set this to production repos)
SANDBOX_REPO=enigma-sandbox/opentelemetry-demo

# Judge Access & Authentication
JUDGE_INVITE_CODE=ENIGMA-GCP-2026

# Execution mode: "live" or "replay" (default: "live")
DEFAULT_MODE=live
